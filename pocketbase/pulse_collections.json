[
  {
    "id": "pbc_pulse_editors",
    "name": "pulse_editors",
    "type": "auth",
    "system": false,
    "listRule": "id = @request.auth.id",
    "viewRule": "id = @request.auth.id",
    "createRule": null,
    "updateRule": null,
    "deleteRule": null,
    "authRule": "",
    "manageRule": null,
    "passwordAuth": { "enabled": true, "identityFields": ["email"] },
    "oauth2": { "enabled": false },
    "otp": { "enabled": false },
    "mfa": { "enabled": false },
    "fields": [
      { "name": "name", "type": "text", "required": false, "max": 80 },
      { "name": "created", "type": "autodate", "onCreate": true, "onUpdate": false },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ],
    "indexes": []
  },
  {
    "id": "pbc_pulse_apps",
    "name": "pulse_apps",
    "type": "base",
    "system": false,
    "listRule": "visible = true || @request.auth.collectionName = \"pulse_editors\"",
    "viewRule": "visible = true || @request.auth.collectionName = \"pulse_editors\"",
    "createRule": "@request.auth.collectionName = \"pulse_editors\"",
    "updateRule": "@request.auth.collectionName = \"pulse_editors\"",
    "deleteRule": "@request.auth.collectionName = \"pulse_editors\"",
    "fields": [
      { "name": "name", "type": "text", "required": true, "presentable": true, "max": 80 },
      { "name": "slug", "type": "text", "required": true, "max": 80, "pattern": "^[a-z0-9-]+$" },
      { "name": "tagline", "type": "text", "max": 160 },
      { "name": "accent", "type": "text", "required": true, "max": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
      { "name": "store_id", "type": "text", "max": 40 },
      { "name": "status", "type": "select", "required": true, "maxSelect": 1, "values": ["unknown", "operational", "degraded", "partial_outage", "major_outage", "maintenance"] },
      { "name": "status_message", "type": "text", "max": 280 },
      { "name": "sort", "type": "number", "onlyInt": true },
      { "name": "visible", "type": "bool" },
      { "name": "created", "type": "autodate", "onCreate": true, "onUpdate": false },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_pulse_apps_slug ON pulse_apps (slug)"]
  },
  {
    "id": "pbc_pulse_posts",
    "name": "pulse_posts",
    "type": "base",
    "system": false,
    "listRule": "(state = \"published\" && publish_at <= @now) || @request.auth.collectionName = \"pulse_editors\"",
    "viewRule": "(state = \"published\" && publish_at <= @now) || @request.auth.collectionName = \"pulse_editors\"",
    "createRule": "@request.auth.collectionName = \"pulse_editors\"",
    "updateRule": "@request.auth.collectionName = \"pulse_editors\"",
    "deleteRule": "@request.auth.collectionName = \"pulse_editors\"",
    "fields": [
      { "name": "title", "type": "text", "required": true, "presentable": true, "max": 160 },
      { "name": "summary", "type": "text", "max": 320 },
      { "name": "body", "type": "text", "max": 100000 },
      { "name": "kind", "type": "select", "required": true, "maxSelect": 1, "values": ["announcement", "news", "event", "maintenance"] },
      { "name": "apps", "type": "relation", "collectionId": "pbc_pulse_apps", "maxSelect": 50, "minSelect": 0, "cascadeDelete": false },
      { "name": "pinned", "type": "bool" },
      { "name": "state", "type": "select", "required": true, "maxSelect": 1, "values": ["draft", "published"] },
      { "name": "publish_at", "type": "date", "required": true },
      { "name": "cover", "type": "file", "maxSelect": 1, "maxSize": 5242880, "mimeTypes": ["image/png", "image/jpeg", "image/webp"], "thumbs": [], "protected": false },
      { "name": "created", "type": "autodate", "onCreate": true, "onUpdate": false },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ],
    "indexes": ["CREATE INDEX idx_pulse_posts_publish ON pulse_posts (state, publish_at)"]
  },
  {
    "id": "pbc_pulse_releases",
    "name": "pulse_releases",
    "type": "base",
    "system": false,
    "listRule": "(state = \"published\" && released_at <= @now) || @request.auth.collectionName = \"pulse_editors\"",
    "viewRule": "(state = \"published\" && released_at <= @now) || @request.auth.collectionName = \"pulse_editors\"",
    "createRule": "@request.auth.collectionName = \"pulse_editors\"",
    "updateRule": "@request.auth.collectionName = \"pulse_editors\"",
    "deleteRule": "@request.auth.collectionName = \"pulse_editors\"",
    "fields": [
      { "name": "app", "type": "relation", "required": true, "collectionId": "pbc_pulse_apps", "maxSelect": 1, "minSelect": 0, "cascadeDelete": false },
      { "name": "version", "type": "text", "required": true, "presentable": true, "max": 40 },
      { "name": "title", "type": "text", "max": 160 },
      { "name": "notes", "type": "text", "max": 100000 },
      { "name": "channel", "type": "select", "required": true, "maxSelect": 1, "values": ["stable", "beta"] },
      { "name": "state", "type": "select", "required": true, "maxSelect": 1, "values": ["draft", "published"] },
      { "name": "released_at", "type": "date", "required": true },
      { "name": "created", "type": "autodate", "onCreate": true, "onUpdate": false },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ],
    "indexes": ["CREATE INDEX idx_pulse_releases_date ON pulse_releases (state, released_at)"]
  },
  {
    "id": "pbc_pulse_incidents",
    "name": "pulse_incidents",
    "type": "base",
    "system": false,
    "listRule": "",
    "viewRule": "",
    "createRule": "@request.auth.collectionName = \"pulse_editors\"",
    "updateRule": "@request.auth.collectionName = \"pulse_editors\"",
    "deleteRule": "@request.auth.collectionName = \"pulse_editors\"",
    "fields": [
      { "name": "title", "type": "text", "required": true, "presentable": true, "max": 160 },
      { "name": "severity", "type": "select", "required": true, "maxSelect": 1, "values": ["minor", "major", "critical"] },
      { "name": "phase", "type": "select", "required": true, "maxSelect": 1, "values": ["investigating", "identified", "monitoring", "resolved"] },
      { "name": "apps", "type": "relation", "collectionId": "pbc_pulse_apps", "maxSelect": 50, "minSelect": 0, "cascadeDelete": false },
      { "name": "started_at", "type": "date", "required": true },
      { "name": "resolved_at", "type": "date" },
      { "name": "created", "type": "autodate", "onCreate": true, "onUpdate": false },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ],
    "indexes": []
  },
  {
    "id": "pbc_pulse_inc_upd",
    "name": "pulse_incident_updates",
    "type": "base",
    "system": false,
    "listRule": "",
    "viewRule": "",
    "createRule": "@request.auth.collectionName = \"pulse_editors\"",
    "updateRule": "@request.auth.collectionName = \"pulse_editors\"",
    "deleteRule": "@request.auth.collectionName = \"pulse_editors\"",
    "fields": [
      { "name": "incident", "type": "relation", "required": true, "collectionId": "pbc_pulse_incidents", "maxSelect": 1, "minSelect": 0, "cascadeDelete": true },
      { "name": "phase", "type": "select", "required": true, "maxSelect": 1, "values": ["investigating", "identified", "monitoring", "resolved"] },
      { "name": "message", "type": "text", "required": true, "presentable": true, "max": 2000 },
      { "name": "created", "type": "autodate", "onCreate": true, "onUpdate": false },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ],
    "indexes": []
  }
]
